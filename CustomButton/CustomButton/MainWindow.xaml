<Window x:Class="CustomButton.MainWindow"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
     mc:Ignorable="d"
     Title="Custom Button"
     Height="106"
     Width="113"
     ResizeMode="NoResize"
     WindowStyle="SingleBorderWindow"
     Topmost="True"
     Background="#2B2B2B">
    <Window.InputBindings>
        <KeyBinding Key="Oem102" Command="{Binding Mayor}" />
        <KeyBinding Key="Oem102" Modifiers="Shift" Command="{Binding Menor}" />
    </Window.InputBindings>
    <Grid Margin="0,0,3,4">
        <Button Content="&lt;"   
                Command="{Binding Mayor}"  
                Focusable="False" 
                HorizontalAlignment="Left" Margin="2,0,0,0" VerticalAlignment="Center" Height="85" Width="55"/>

        <Button Content="&gt;"  
                Command="{Binding Menor}" 
                Focusable="False" 
                HorizontalAlignment="Left" Margin="55,0,0,0" VerticalAlignment="Center" Height="85" Width="55"/>
    </Grid>
</Window>
